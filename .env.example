# ─── Autenticação ─────────────────────────────────────────────────────────
# Provedor de auth: "atem" (Cognito Atem) ou "ream" (Middleware Ream)
VITE_AUTH_PROVIDER=atem

# Identificador do produto, enviado no payload de logout
VITE_AUTH_RULES=portal_nave

# Roles que ativam modo admin (separados por vírgula)
VITE_AUTH_ADMIN_ROLES=admin

# ─── Aplicação ────────────────────────────────────────────────────────────
VITE_APP_NAME=Novo Projeto Atem

# "development" | "homologation" | "production"
# Se omitido, deriva do hostname (localhost → development, *-dev → homologation).
VITE_APP_ENV=development

# ─── DEV ONLY: bypass de autenticação ─────────────────────────────────────
# "true" injeta um usuário mock e pula o refresh/login real (sem SPA de login).
# NUNCA use em homolog/produção.
# VITE_AUTH_BYPASS=true
#
# Com o bypass ligado, o mock é admin por padrão (ignora RBAC). Para testar o
# RBAC como usuário comum, defina "false" e liste as permissões concedidas:
# VITE_AUTH_BYPASS_ADMIN=false
# VITE_AUTH_BYPASS_PERMISSIONS=portal_nave:dashboard:read,portal_nave:movements:read

# Override da API de negócio (opcional, só o host — os endpoints já têm /rest).
# Se vazio, usa o default por ambiente (dev/homolog: mw-nave-dev).
# VITE_API_URL=https://mw-nave-dev.grupoatem.com.br

# Override do endpoint de auth (opcional). Se vazio, usa o preset do provider.
# VITE_AUTH_URL=https://gateway-dev.grupoatem.com.br

# ─── Observabilidade (opcionais) ──────────────────────────────────────────
# Deixe vazio para desabilitar.
VITE_FLAGSMITH_ENV_ID=
VITE_DATADOG_APP_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SERVICE=

# ─── Dev proxy (opcional) ─────────────────────────────────────────────────
# Se preenchido, o Vite faz proxy de /rest para esse alvo durante o dev.
# VITE_API_PROXY_TARGET=https://mw-nave-dev.grupoatem.com.br
